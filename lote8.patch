+/* Quem tem as 5 pecas do Exodia na mao vence (Duel_HasAllExodiaPieces do jogo). */
+static bool HasAllExodiaPieces(const DuelPlayerState* side) {
+    bool found[DUEL_EXODIA_PIECE_COUNT] = {false, false, false, false, false};
+
+    for (int slot = 0; slot < DUEL_HAND_SIZE; slot++) {
+        const int id = side->hand.cards[slot];
+
+        if (
+            id >= DUEL_EXODIA_FIRST_CARD_ID &&
+            id < DUEL_EXODIA_FIRST_CARD_ID + DUEL_EXODIA_PIECE_COUNT
+        ) {
+            found[id - DUEL_EXODIA_FIRST_CARD_ID] = true;
+        }
+    }
+
+    for (int i = 0; i < DUEL_EXODIA_PIECE_COUNT; i++) {
+        if (!found[i]) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+/* true se o duelo terminou (ja terminado ou por Exodia). */
+static bool CheckExodia() {
+    if (duel.finished) {
+        return true;
+    }
+
+    if (HasAllExodiaPieces(&duel.player)) {
+        FinishDuel(true, DUEL_FINISH_EXODIA);
+        return true;
+    }
+
+    if (HasAllExodiaPieces(&duel.opponent)) {
+        FinishDuel(false, DUEL_FINISH_EXODIA);
+        return true;
+    }
+
+    return false;
+}
