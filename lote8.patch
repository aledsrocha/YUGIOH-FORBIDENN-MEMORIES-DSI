+void DuelOverlay_DrawRitualPanel(int ritualCardId) {
+    const DuelState* state = DuelEngine_GetState();
+    int tributes[DUEL_RITUAL_TRIBUTE_COUNT];
+    int resultId = 0;
+
+    if (
+        state == nullptr ||
+        !DuelEngine_GetRitualRecipe(ritualCardId, tributes, &resultId)
+    ) {
+        return;
+    }
+
+    const CardData* result = GameData_GetCardById(resultId);
+
+    if (result == nullptr) {
+        return;
+    }
+
+    drawInfoPanel(4);
+
+    char line[40];
+    char name[24];
+
+    copyName(name, sizeof(name), result->name, 17);
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 3, name, PixelText_Color(18, 31, 20));
+
+    /* cada tributo toma o primeiro monstro igual ainda nao usado (mesma regra do motor) */
+    bool used[DUEL_FIELD_SIZE] = {false, false, false, false, false};
+
+    for (int j = 0; j < DUEL_RITUAL_TRIBUTE_COUNT; j++) {
+        bool present = false;
+
+        for (int i = 0; i < DUEL_FIELD_SIZE && !present; i++) {
+            if (!used[i] && state->player.field[i].cardId == tributes[j]) {
+                used[i] = true;
+                present = true;
+            }
+        }
+
