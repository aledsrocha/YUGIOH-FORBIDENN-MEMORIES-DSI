+bool DuelEngine_GetRitualRecipe(int ritualCardId, int* tributes, int* resultCardId) {
+    for (int i = 0; i < kRitualRecipeCount; i++) {
+        if (kRitualRecipes[i][0] != ritualCardId) {
+            continue;
+        }
+
+        if (tributes != nullptr) {
+            for (int j = 0; j < DUEL_RITUAL_TRIBUTE_COUNT; j++) {
+                tributes[j] = kRitualRecipes[i][1 + j];
+            }
+        }
+
+        if (resultCardId != nullptr) {
+            *resultCardId = kRitualRecipes[i][4];
+        }
+
+        return true;
+    }
+
+    return false;
+}
+
+bool DuelEngine_PlayRitualFromHand(int handIndex, DuelSpellOutcome* outcome) {
+    if (
+        duel.finished ||
+        duel.turn != DUEL_TURN_PLAYER ||
+        handIndex < 0 ||
+        handIndex >= DUEL_HAND_SIZE
+    ) {
+        return false;
+    }
+
+    const int cardId = duel.player.hand.cards[handIndex];
+    const CardData* card = GameData_GetCardById(cardId);
+
+    if (card == nullptr || card->type != 22) {
+        return false;
+    }
+
+    int tributes[DUEL_RITUAL_TRIBUTE_COUNT];
+    int resultId = 0;
+
+    if (!DuelEngine_GetRitualRecipe(cardId, tributes, &resultId)) {
+        return false;
+    }
+
+    const CardData* result = GameData_GetCardById(resultId);
+
+    if (result == nullptr) {
+        return false;
+    }
+
+    /* cada tributo toma o primeiro monstro igual ainda nao usado, na ordem da receita */
+    int found[DUEL_RITUAL_TRIBUTE_COUNT] = {-1, -1, -1};
+    bool used[DUEL_FIELD_SIZE] = {false, false, false, false, false};
+
+    for (int j = 0; j < DUEL_RITUAL_TRIBUTE_COUNT; j++) {
+        for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+            if (!used[i] && duel.player.field[i].cardId == tributes[j]) {
+                found[j] = i;
+                used[i] = true;
+                break;
+            }
+        }
+
+        if (found[j] < 0) {
+            return false;
+        }
+    }
+
+    for (int j = 0; j < DUEL_RITUAL_TRIBUTE_COUNT; j++) {
+        ClearFieldCard(&duel.player.field[found[j]]);
+    }
+
+    /* o resultado ocupa a zona do segundo tributo */
+    DuelFieldCard* field = &duel.player.field[found[1]];
+
+    field->cardId = static_cast<uint16_t>(resultId);
+    field->position = DUEL_POSITION_ATTACK;
+    field->faceUp = true;
+    field->hasAttacked = false;
+    field->attackBonus = 0;
+    field->defenseBonus = 0;
+    field->guardianStar = PickGuardianStar(result, 0);
+
+    duel.player.hand.cards[handIndex] = 0;
+
+    if (outcome != nullptr) {
+        outcome->effectGroup = DUEL_EFFECT_GROUP_RITUAL;
+        outcome->amount = resultId;
+        outcome->affected = 0;
+        outcome->destroyed = DUEL_RITUAL_TRIBUTE_COUNT;
+    }
+
+    return true;
+}
+
+bool DuelEngine_BuildTestDeck(uint16_t* outCards) {
+    if (outCards == nullptr) {
+        return false;
+    }
+
+    for (int i = 0; i < DUEL_DECK_SIZE; i++) {
+        if (GameData_GetCardById(kTestDeck[i]) == nullptr) {
+            return false;
+        }
+
+        outCards[i] = kTestDeck[i];
+    }
+
+    return true;
+}
