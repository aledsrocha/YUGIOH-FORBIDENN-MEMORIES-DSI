+bool DuelFieldMode::showCardMessage(const char* message) {
+    if (selectedHandPosition_ >= playerHand_.size()) {
+        return false;
+    }
+
+    const CardData* card =
+        GameData_GetCardByIndex(
+            static_cast<int>(
+                playerHand_.cardAt(
+                    selectedHandPosition_
+                )
+            )
+        );
+
+    if (card == nullptr) {
+        return false;
+    }
+
+    std::snprintf(
+        bannerMessage_,
+        sizeof(bannerMessage_),
+        "%s",
+        message
+    );
+
+    bannerActive_ = true;
+    bannerIsMessage_ = true;
+    bannerCardId_ = card->id;
+
+    return true;
