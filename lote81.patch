+void DuelOverlay_DrawMessageBanner(int cardId, const char* message) {
+    const CardData* card = GameData_GetCardById(cardId);
+
+    if (card == nullptr || message == nullptr) {
+        return;
+    }
+
+    constexpr int x = 40;
+    constexpr int y = 80;
+    constexpr int width = 176;
+    constexpr int height = 32;
+
+    PixelText_Fill(x, y, width, height, PixelText_Color(2, 3, 8));
+    PixelText_Frame(x, y, width, height, PixelText_Color(31, 10, 8));
+
+    char name[24];
+
+    copyName(name, sizeof(name), card->name, 21);
+    PixelText_Draw(x + 4, y + 4, name, PixelText_Color(18, 31, 20));
+    PixelText_Draw(x + 4, y + 17, message, PixelText_Color(31, 14, 10));
+}
