diff -u -r -N include.l2/duel/ListMenu.h include/duel/ListMenu.h
--- include.l2/duel/ListMenu.h	1970-01-01 00:00:00.000000000 +0000
+++ include/duel/ListMenu.h	2026-10-22 22:42:24.892164057 +0000
@@ -0,0 +1,60 @@
+#pragma once
+
+namespace YGOFM {
+
+/* Navegacao de lista pura (sem DS), testada no PC. */
+
+/* Passo de 1 com volta ao outro extremo. */
+inline int ListMenu_Step(int index, int delta, int count) {
+    if (count <= 0) {
+        return 0;
+    }
+
+    int next = (index + delta) % count;
+
+    if (next < 0) {
+        next += count;
+    }
+
+    return next;
+}
+
+/* Salto de pagina sem volta (para nos extremos). */
+inline int ListMenu_Page(int index, int delta, int count) {
+    if (count <= 0) {
+        return 0;
+    }
+
+    int next = index + delta;
+
+    if (next < 0) {
+        next = 0;
+    }
+
+    if (next > count - 1) {
+        next = count - 1;
+    }
+
+    return next;
+}
+
+/* Primeira linha visivel: mantem o item selecionado dentro da janela. */
+inline int ListMenu_WindowStart(int index, int count, int rows) {
+    if (count <= rows) {
+        return 0;
+    }
+
+    int start = index - rows / 2;
+
+    if (start < 0) {
+        start = 0;
+    }
+
+    if (start > count - rows) {
+        start = count - rows;
+    }
+
+    return start;
+}
+
+}
