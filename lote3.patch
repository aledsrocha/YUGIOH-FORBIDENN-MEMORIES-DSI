@@ -0,0 +1,57 @@
+#include "duel/PixelFont.h"
+
+namespace YGOFM {
+namespace {
+
+struct GlyphEntry {
+    char character;
+    const char* rows;
+};
+
+const char kBlankGlyph[] = "000000000000000";
+
+const GlyphEntry kGlyphs[] = {
+    {'A', "010101111101101"}, {'B', "110101110101110"},
+    {'C', "011100100100011"}, {'D', "110101101101110"},
+    {'E', "111100110100111"}, {'F', "111100110100100"},
+    {'G', "011100101101011"}, {'H', "101101111101101"},
+    {'I', "111010010010111"}, {'J', "001001001101010"},
+    {'K', "101101110101101"}, {'L', "100100100100111"},
+    {'M', "111111101101101"}, {'N', "111101101101101"},
+    {'O', "010101101101010"}, {'P', "110101110100100"},
+    {'Q', "010101101110011"}, {'R', "110101110101101"},
+    {'S', "011100010001110"}, {'T', "111010010010010"},
+    {'U', "101101101101111"}, {'V', "101101101101010"},
+    {'W', "101101101111111"}, {'X', "101101010101101"},
+    {'Y', "101101010010010"}, {'Z', "111001010100111"},
+    {'0', "111101101101111"}, {'1', "010110010010111"},
+    {'2', "111001111100111"}, {'3', "111001111001111"},
+    {'4', "101101111001001"}, {'5', "111100111001111"},
+    {'6', "111100111101111"}, {'7', "111001010010010"},
+    {'8', "111101111101111"}, {'9', "111101111001111"},
+    {' ', "000000000000000"}, {'-', "000000111000000"},
+    {':', "000010000010000"}, {'.', "000000000000010"},
+    {'>', "100010001010100"}, {'/', "001001010100100"},
+    {'+', "000010111010000"},
+};
+
+constexpr int kGlyphCount =
+    static_cast<int>(sizeof(kGlyphs) / sizeof(kGlyphs[0]));
+
+}
+
+const char* PixelFont_Glyph(char character) {
+    if (character >= 'a' && character <= 'z') {
+        character = static_cast<char>(character - 'a' + 'A');
+    }
+
+    for (int i = 0; i < kGlyphCount; i++) {
+        if (kGlyphs[i].character == character) {
+            return kGlyphs[i].rows;
+        }
+    }
+
+    return kBlankGlyph;
+}
+
+}
diff -u -r -N source.l2/duel/PixelText.cpp source/duel/PixelText.cpp
--- source.l2/duel/PixelText.cpp	1970-01-01 00:00:00.000000000 +0000
+++ source/duel/PixelText.cpp	2026-10-22 22:42:24.891333157 +0000
@@ -0,0 +1,100 @@
+#include "duel/PixelText.h"
+#include "duel/PixelFont.h"
+
+namespace YGOFM {
+namespace {
+
+constexpr int kScreenWidth = 256;
+constexpr int kScreenHeight = 192;
+constexpr int kGlyphSpacing = 1;
+
+u16* pixels() {
+    return reinterpret_cast<u16*>(
+        BG_BMP_RAM(0)
+    );
+}
+
+void putPixel(int x, int y, u16 color) {
+    u16* destination = pixels();
+
+    if (
+        destination == nullptr ||
+        x < 0 ||
+        y < 0 ||
+        x >= kScreenWidth ||
+        y >= kScreenHeight
+    ) {
+        return;
+    }
+
+    destination[y * kScreenWidth + x] = color;
+}
+
+}
+
+u16 PixelText_Color(int red, int green, int blue) {
+    return static_cast<u16>(
+        RGB15(red, green, blue) | BIT(15)
+    );
+}
+
+void PixelText_Fill(int x, int y, int width, int height, u16 color) {
+    for (int row = 0; row < height; row++) {
+        for (int column = 0; column < width; column++) {
+            putPixel(x + column, y + row, color);
+        }
+    }
+}
+
+void PixelText_Frame(int x, int y, int width, int height, u16 color) {
+    PixelText_Fill(x, y, width, 1, color);
+    PixelText_Fill(x, y + height - 1, width, 1, color);
+    PixelText_Fill(x, y, 1, height, color);
+    PixelText_Fill(x + width - 1, y, 1, height, color);
+}
+
+int PixelText_Width(const char* text, int scale) {
+    if (text == nullptr) {
+        return 0;
+    }
+
+    int length = 0;
+
+    while (text[length] != '\0') {
+        length++;
+    }
+
+    return length * (kPixelFontGlyphWidth + kGlyphSpacing) * scale;
+}
+
+void PixelText_Draw(int x, int y, const char* text, u16 color, int scale) {
+    if (text == nullptr || scale < 1) {
+        return;
+    }
+
+    int currentX = x;
+
+    for (int index = 0; text[index] != '\0'; index++) {
+        const char* glyph = PixelFont_Glyph(text[index]);
+
+        for (int row = 0; row < kPixelFontGlyphHeight; row++) {
+            for (int column = 0; column < kPixelFontGlyphWidth; column++) {
+                if (glyph[row * kPixelFontGlyphWidth + column] != '1') {
+                    continue;
+                }
+
+                PixelText_Fill(
+                    currentX + column * scale,
+                    y + row * scale,
+                    scale,
+                    scale,
+                    color
+                );
+            }
+        }
+
+        currentX += (kPixelFontGlyphWidth + kGlyphSpacing) * scale;
+    }
+}
+
+}
