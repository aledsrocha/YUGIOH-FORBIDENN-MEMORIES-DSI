diff -u -r -N source.l2/duel/DuelOverlays.cpp source/duel/DuelOverlays.cpp
--- source.l2/duel/DuelOverlays.cpp	1970-01-01 00:00:00.000000000 +0000
+++ source/duel/DuelOverlays.cpp	2026-10-22 22:42:24.893574217 +0000
@@ -0,0 +1,133 @@
+#include "duel/DuelOverlays.h"
+#include "duel/ListMenu.h"
+#include "duel/PixelText.h"
+
+#include "DuelEngine.h"
+#include "GameData.h"
+#include "graphics/GraphicsEngine.h"
+
+#include <cstdio>
+
+namespace YGOFM {
+namespace {
+
+/* Posicao do painel de estrelas (canto superior direito). Ajuste se
+   sobrepor algo importante na sua tela. */
+constexpr int kStarPanelX = 152;
+constexpr int kStarPanelY = 4;
+constexpr int kStarPanelWidth = 100;
+constexpr int kStarPanelHeight = 42;
+
+constexpr int kMenuListY = 26;
+constexpr int kMenuRowHeight = 12;
+constexpr int kMenuVisibleRows = 12;
+
+}
+
+void DuelOverlay_DrawStarChooser(const CardData* card, int choice) {
+    if (card == nullptr || card->guardian1 == 0) {
+        return;
+    }
+
+    const int first = card->guardian1;
+    const int second = card->guardian2;
+    const bool hasChoice = second != 0 && second != first;
+    const int chosenStar = (choice == 1 && hasChoice) ? second : first;
+
+    const u16 panelColor = PixelText_Color(2, 3, 8);
+    const u16 frameColor = PixelText_Color(28, 22, 6);
+    const u16 textColor = PixelText_Color(31, 31, 31);
+
+    PixelText_Fill(
+        kStarPanelX, kStarPanelY,
+        kStarPanelWidth, kStarPanelHeight,
+        panelColor
+    );
+    PixelText_Frame(
+        kStarPanelX, kStarPanelY,
+        kStarPanelWidth, kStarPanelHeight,
+        frameColor
+    );
+
+    char line[24];
+    int y = kStarPanelY + 3;
+
+    std::snprintf(
+        line, sizeof(line), "%c %s",
+        chosenStar == first ? '>' : ' ',
+        DuelEngine_GuardianStarName(first)
+    );
+    PixelText_Draw(kStarPanelX + 4, y, line, textColor);
+    y += 12;
+
+    if (hasChoice) {
+        std::snprintf(
+            line, sizeof(line), "%c %s",
+            chosenStar == second ? '>' : ' ',
+            DuelEngine_GuardianStarName(second)
+        );
+        PixelText_Draw(kStarPanelX + 4, y, line, textColor);
+        y += 12;
+    }
+
+    int wins = 0;
+    int losses = 0;
+
+    DuelEngine_CountStarMatchups(chosenStar, &wins, &losses);
+
+    std::snprintf(line, sizeof(line), "VS +%d -%d", wins, losses);
+    PixelText_Draw(kStarPanelX + 4, y, line, textColor);
+}
+
+void DuelOverlay_DrawDuelistMenu(int selectedIndex) {
+    const int count = GameData_GetDuelistCount();
+
+    Graphics_ClearTop(PixelText_Color(2, 2, 8));
+
+    const u16 titleColor = PixelText_Color(31, 24, 4);
+    const u16 textColor = PixelText_Color(31, 31, 31);
+    const u16 highlight = PixelText_Color(6, 8, 18);
+
+    PixelText_Draw(8, 6, "SELECT OPPONENT", titleColor);
+
+    char line[40];
+
+    std::snprintf(
+        line, sizeof(line), "%02d/%02d", selectedIndex + 1, count
+    );
+    PixelText_Draw(256 - 8 - PixelText_Width(line), 6, line, titleColor);
+
+    const int start =
+        ListMenu_WindowStart(selectedIndex, count, kMenuVisibleRows);
+
+    for (int row = 0; row < kMenuVisibleRows; row++) {
+        const int index = start + row;
+
+        if (index >= count) {
+            break;
+        }
+
+        const DuelistData* duelist = GameData_GetDuelistByIndex(index);
+
+        if (duelist == nullptr) {
+            continue;
+        }
+
+        const int y = kMenuListY + row * kMenuRowHeight;
+
+        if (index == selectedIndex) {
+            PixelText_Fill(4, y - 1, 248, kMenuRowHeight, highlight);
+        }
+
+        std::snprintf(
+            line, sizeof(line), "%c %s",
+            index == selectedIndex ? '>' : ' ',
+            duelist->name
+        );
+        PixelText_Draw(8, y + 1, line, textColor);
+    }
+
+    PixelText_Draw(8, 178, "A:START  L R:PAGE", titleColor);
+}
+
+}
diff -u -r -N source.l2/duel/PixelFont.cpp source/duel/PixelFont.cpp
--- source.l2/duel/PixelFont.cpp	1970-01-01 00:00:00.000000000 +0000
