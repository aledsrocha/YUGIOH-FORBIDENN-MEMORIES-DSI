+const char* DuelEngine_GuardianStarName(int star) {
+    static const char* const names[] = {
+        "", "MARS", "JUPITER", "SATURN", "URANUS", "PLUTO", "NEPTUNE",
+        "MERCURY", "SUN", "MOON", "VENUS"
+    };
+
+    if (star < 1 || star > 10) {
+        return "";
+    }
+
+    return names[star];
+}
+
+void DuelEngine_CountStarMatchups(int star, int* wins, int* losses) {
+    int winCount = 0;
+    int lossCount = 0;
+
+    for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+        const DuelFieldCard& other = duel.opponent.field[i];
+
+        if (other.cardId == 0 || !other.faceUp) {
+            continue;
+        }
+
+        if (DuelEngine_GuardianStarBeats(star, other.guardianStar)) {
+            winCount++;
+        } else if (DuelEngine_GuardianStarBeats(other.guardianStar, star)) {
+            lossCount++;
+        }
+    }
+
+    if (wins != nullptr) {
+        *wins = winCount;
+    }
+
+    if (losses != nullptr) {
+        *losses = lossCount;
+    }
+}
