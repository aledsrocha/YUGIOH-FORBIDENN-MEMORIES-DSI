+    int used = std::snprintf(line, sizeof(line), "%s ", failedMask ? "FAIL" : "FUSE");
+
+    for (int i = 0; i < count && used < 30; i++) {
+        used += std::snprintf(
+            line + used, sizeof(line) - used, i ? ">%d" : "%d", pickPositions[i] + 1
+        );
+    }
+
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 3, line, failedMask ? warnColor : goodColor);
+
+    const CardData* result = GameData_GetCardById(resultId);
+
+    if (result == nullptr) {
+        return;
+    }
+
+    copyName(line, sizeof(line), result->name, 17);
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 15, line, textColor);
+
+    if (result->type >= DUEL_FIRST_NON_MONSTER_TYPE) {
+        PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 27, "NOT A MONSTER", warnColor);
+        return;
+    }
+
+    const int terrainBoost = DuelEngine_GetTerrainBoost(result->type, DuelEngine_GetTerrain());
+
+    std::snprintf(
+        line, sizeof(line), "ATK %d DEF %d",
+        clampStat(result->attack + attackBonus + terrainBoost),
+        clampStat(result->defense + defenseBonus + terrainBoost)
+    );
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 27, line, textColor);
+}
+
+void DuelOverlay_DrawEquipPanel(int equipCardId, int fieldSlot) {
+    const DuelState* state = DuelEngine_GetState();
+    const CardData* equip = GameData_GetCardById(equipCardId);
+
+    if (
+        state == nullptr || equip == nullptr ||
+        fieldSlot < 0 || fieldSlot >= DUEL_FIELD_SIZE
+    ) {
+        return;
+    }
+
+    const CardData* monster = GameData_GetCardById(state->player.field[fieldSlot].cardId);
+
+    if (monster == nullptr) {
+        return;
+    }
+
+    const int bonus = DuelEngine_GetEquipBonus(equipCardId);
+    const int attack = DuelEngine_GetFieldAttack(false, fieldSlot);
+    const int defense = DuelEngine_GetFieldDefense(false, fieldSlot);
+
+    const u16 textColor = PixelText_Color(31, 31, 31);
+
+    drawInfoPanel(4);
+
+    char line[40];
+    char name[24];
+
+    copyName(name, sizeof(name), equip->name, 11);
+    std::snprintf(line, sizeof(line), "EQUIP %s", name);
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 3, line, PixelText_Color(18, 31, 20));
+
+    copyName(name, sizeof(name), monster->name, 14);
+    std::snprintf(line, sizeof(line), "ON %s", name);
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 15, line, textColor);
+
+    std::snprintf(line, sizeof(line), "ATK %d>%d", attack, clampStat(attack + bonus));
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 27, line, textColor);
+
+    std::snprintf(line, sizeof(line), "DEF %d>%d", defense, clampStat(defense + bonus));
+    PixelText_Draw(kInfoPanelX + 4, kInfoPanelY + 39, line, textColor);
+}
