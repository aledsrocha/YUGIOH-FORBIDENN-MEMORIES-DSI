+bool DuelFieldMode::toggleFusionPick() {
+    if (
+        isDuelFinished() ||
+        cardPlayedThisTurn_ ||
+        playerHand_.isEmpty() ||
+        selectedHandPosition_ >= playerHand_.size()
+    ) {
+        return false;
+    }
+
+    const int position =
+        static_cast<int>(selectedHandPosition_);
+
+    for (int i = 0; i < fusionPickCount_; i++) {
+        if (fusionPicks_[i] != position) {
+            continue;
+        }
+
+        /* ja marcada: desmarca e mantem a ordem das demais */
+        for (int k = i; k + 1 < fusionPickCount_; k++) {
+            fusionPicks_[k] = fusionPicks_[k + 1];
+        }
+
+        fusionPickCount_--;
+
+        return true;
+    }
+
+    if (fusionPickCount_ >= 5) {
+        return false;
+    }
+
+    fusionPicks_[fusionPickCount_] = position;
+    fusionPickCount_++;
+
+    return true;
+}
+
+bool DuelFieldMode::clearFusionPicks() {
+    if (fusionPickCount_ == 0) {
+        return false;
+    }
+
+    fusionPickCount_ = 0;
+
+    return true;
+}
+
+bool DuelFieldMode::beginPlaySelection() {
+    if (
+        isDuelFinished() ||
+        cardPlayedThisTurn_ ||
+        summonSelectionActive_ ||
+        playerHand_.isEmpty() ||
+        selectedHandPosition_ >= playerHand_.size()
+    ) {
+        return false;
+    }
+
+    /* cartas marcadas com Y: invocacao por fusao em cadeia */
+    if (fusionPickCount_ > 0) {
+        return beginChainSummonSelection();
+    }
+
+    const CardData* card =
+        GameData_GetCardByIndex(
+            static_cast<int>(
+                playerHand_.cardAt(
+                    selectedHandPosition_
+                )
+            )
+        );
+
+    if (card == nullptr) {
+        return false;
+    }
+
+    /* carta de terreno (ids 330-335): joga na hora */
+    if (
+        card->type == 20 &&
+        card->id >= DUEL_FIRST_TERRAIN_CARD_ID &&
+        card->id < DUEL_FIRST_TERRAIN_CARD_ID + DUEL_TERRAIN_COUNT
+    ) {
+        return playTerrainFromHand();
+    }
+
+    /* equip: escolhe o monstro em campo que vai recebe-lo */
+    if (card->type == 23) {
+        return beginEquipSelection();
+    }
+
+    return beginSummonSelection();
+}
+
+bool DuelFieldMode::beginChainSummonSelection() {
+    if (
+        summonSelectionActive_ ||
+        fusionPickCount_ <= 0
+    ) {
+        return false;
+    }
+
+    int slots[5];
+
+    for (int i = 0; i < fusionPickCount_; i++) {
+        slots[i] =
+            DuelEngine_FindPlayerHandSlotByOrder(
+                fusionPicks_[i]
+            );
+
+        if (slots[i] < 0) {
+            return false;
+        }
+    }
+
+    int resultId = 0;
+
+    if (!DuelEngine_PreviewFuseChain(
+        slots,
+        fusionPickCount_,
+        &resultId,
+        nullptr,
+        nullptr,
+        nullptr
+    )) {
+        return false;
+    }
+
+    const CardData* result =
+        GameData_GetCardById(resultId);
+
+    /* o resultado precisa ser um monstro para ir ao campo */
+    if (
+        result == nullptr ||
+        result->type >= 20
+    ) {
+        return false;
+    }
+
+    confirmedCardIndex_ =
+        static_cast<std::uint16_t>(
+            resultId - 1
+        );
+    confirmedZoneIndex_ =
+        kInvalidZoneIndex;
+    cardConfirmed_ = true;
+    summonSelectionActive_ = true;
+    summonTargetConfirmed_ = false;
+    selectedSummonPosition_ =
+        MonsterPosition::Attack;
+
+    if (!selectFirstAvailableMonsterZone()) {
+        clearSummonState();
+        return false;
+    }
+
+    return true;
+}
+
+bool DuelFieldMode::commitChainSummon() {
+    if (
+        isDuelFinished() ||
+        cardPlayedThisTurn_ ||
+        !summonSelectionActive_ ||
+        !summonTargetConfirmed_ ||
+        fusionPickCount_ <= 0 ||
+        confirmedZoneIndex_ ==
+            kInvalidZoneIndex
+    ) {
+        return false;
+    }
+
+    FieldZone* targetZone =
+        field_.zone(
+            confirmedZoneIndex_
+        );
+
+    if (
+        !isValidSummonZone(
+            targetZone
+        ) ||
+        selectedSummonSlot_ < 0 ||
+        selectedSummonSlot_ >=
+            kMonsterZoneCount
+    ) {
+        return false;
+    }
+
+    int slots[5];
+
+    for (int i = 0; i < fusionPickCount_; i++) {
+        slots[i] =
+            DuelEngine_FindPlayerHandSlotByOrder(
+                fusionPicks_[i]
+            );
+
+        if (slots[i] < 0) {
+            return false;
+        }
+    }
+
+    const DuelPosition enginePosition =
+        selectedSummonPosition_ ==
+            MonsterPosition::Defense
+                ? DUEL_POSITION_DEFENSE
+                : DUEL_POSITION_ATTACK;
+
+    if (!DuelEngine_FuseChainFromHand(
+        slots,
+        fusionPickCount_,
+        selectedSummonSlot_,
+        enginePosition
+    )) {
+        return false;
+    }
+
+    cardPlayedThisTurn_ = true;
+
+    DuelEngine_SetGuardianStar(
+        selectedSummonSlot_,
+        selectedGuardianChoice_
+    );
+
+    synchronizeMonsterFieldsFromEngine();
+    synchronizeHandFromEngine();
+
+    cursor_.selectZone(
+        targetZone->index()
+    );
+
+    clearSummonState();
+
+    return true;
+}
+
+bool DuelFieldMode::playTerrainFromHand() {
+    const int slot =
+        DuelEngine_FindPlayerHandSlotByOrder(
+            static_cast<int>(
+                selectedHandPosition_
+            )
+        );
+
+    if (
+        slot < 0 ||
+        !DuelEngine_PlayFieldMagicFromHand(slot)
+    ) {
+        return false;
+    }
+
+    cardPlayedThisTurn_ = true;
+
+    synchronizeHandFromEngine();
+
+    return true;
+}
+
+int DuelFieldMode::equipCardId() {
+    const DuelState* state =
+        DuelEngine_GetState();
+
+    const int slot =
+        DuelEngine_FindPlayerHandSlotByOrder(
+            equipHandPosition_
+        );
+
+    if (state == nullptr || slot < 0) {
+        return 0;
+    }
+
+    return state->player.hand.cards[slot];
+}
+
+int DuelFieldMode::findEquipTarget(
+    int start,
+    int direction
+) {
+    const DuelState* state =
+        DuelEngine_GetState();
+
+    const int equipId =
+        equipCardId();
+
+    if (state == nullptr || equipId == 0) {
+        return -1;
+    }
+
+    for (int attempt = 1; attempt <= DUEL_FIELD_SIZE; attempt++) {
+        int candidate =
+            (start + direction * attempt) %
+            DUEL_FIELD_SIZE;
+
+        if (candidate < 0) {
+            candidate += DUEL_FIELD_SIZE;
+        }
+
+        const std::uint16_t monsterId =
+            state->player.field[candidate].cardId;
+
+        if (
+            monsterId != 0 &&
+            EquipEngine_CanEquip(
+                equipId,
+                monsterId
+            )
+        ) {
+            return candidate;
+        }
+    }
+
+    return -1;
+}
+
+bool DuelFieldMode::beginEquipSelection() {
+    if (equipSelectionActive_) {
+        return false;
+    }
+
+    equipHandPosition_ =
+        static_cast<int>(
+            selectedHandPosition_
+        );
+
+    const int first =
+        findEquipTarget(-1, 1);
+
+    if (first < 0) {
+        return false;
+    }
+
+    equipTargetSlot_ = first;
+    equipSelectionActive_ = true;
+
+    return true;
+}
+
+bool DuelFieldMode::moveEquipTarget(int direction) {
+    if (!equipSelectionActive_) {
+        return false;
+    }
+
+    const int next =
+        findEquipTarget(
+            equipTargetSlot_,
+            direction
+        );
+
+    if (next < 0 || next == equipTargetSlot_) {
+        return false;
+    }
+
+    equipTargetSlot_ = next;
+
+    return true;
+}
+
+bool DuelFieldMode::commitEquip() {
+    if (
+        !equipSelectionActive_ ||
+        equipTargetSlot_ < 0 ||
+        isDuelFinished() ||
+        cardPlayedThisTurn_
+    ) {
+        return false;
+    }
+
+    const int slot =
+        DuelEngine_FindPlayerHandSlotByOrder(
+            equipHandPosition_
+        );
+
+    if (
+        slot < 0 ||
+        !DuelEngine_EquipFromHand(
+            slot,
+            equipTargetSlot_
+        )
+    ) {
+        return false;
+    }
+
+    cardPlayedThisTurn_ = true;
+    equipSelectionActive_ = false;
+    equipTargetSlot_ = -1;
+
+    synchronizeMonsterFieldsFromEngine();
+    synchronizeHandFromEngine();
+
+    return true;
+}
+
+bool DuelFieldMode::cancelEquipSelection() {
+    if (!equipSelectionActive_) {
+        return false;
+    }
+
+    equipSelectionActive_ = false;
+    equipTargetSlot_ = -1;
+
+    return true;
+}
