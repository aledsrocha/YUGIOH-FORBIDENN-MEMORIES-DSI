+int DuelEngine_GetTerrainBoost(int cardType, int terrain) {
+    if (
+        terrain < 1 ||
+        terrain > DUEL_TERRAIN_COUNT ||
+        cardType < 0 ||
+        cardType >= DUEL_FIRST_NON_MONSTER_TYPE
