+    const DuelPlayerState* side = opponent ? &duel.opponent : &duel.player;
+
+    if (side->turnsTaken < 2) {
+        return DUEL_ATTACK_BLOCK_FIRST_TURN;
+    }
+
+    if (side->swordsTurnsRemaining != 0) {
+        return DUEL_ATTACK_BLOCK_SWORDS;
+    }
+
+    return DUEL_ATTACK_BLOCK_NONE;
+}
+
+bool DuelEngine_SummonFromHand(
+    int handIndex,
+    int fieldIndex,
+    DuelPosition position
+) {
+    return DuelEngine_SummonFromHandEx(handIndex, fieldIndex, position, false);
+}
+
+bool DuelEngine_FuseChainFromHand(
+    const int* handSlots,
+    int count,
+    int fieldIndex,
+    DuelPosition position
+) {
+    return DuelEngine_FuseChainFromHandEx(handSlots, count, fieldIndex, position, false);
+}
+
+int DuelEngine_SetCardFromHand(int handIndex) {
+    if (
+        duel.finished ||
+        duel.turn != DUEL_TURN_PLAYER ||
+        handIndex < 0 ||
+        handIndex >= DUEL_HAND_SIZE
+    ) {
+        return -1;
+    }
+
+    const int cardId = duel.player.hand.cards[handIndex];
+    const CardData* card = GameData_GetCardById(cardId);
+
+    /* monstros vao para o campo de monstros (DuelEngine_SummonFromHandEx) */
+    if (card == nullptr || card->type < DUEL_FIRST_NON_MONSTER_TYPE) {
+        return -1;
+    }
+
+    for (int i = 0; i < DUEL_SPELL_TRAP_SIZE; i++) {
+        if (duel.player.spellTrap[i].cardId == 0) {
+            duel.player.spellTrap[i].cardId = static_cast<uint16_t>(cardId);
+            duel.player.spellTrap[i].faceUp = false;
+            duel.player.hand.cards[handIndex] = 0;
+
+            return i;
+        }
+    }
+
+    return -1;
+}
+
+bool DuelEngine_PopEvent(DuelEvent* out) {
+    if (gEventCount == 0) {
+        return false;
+    }
+
+    if (out != nullptr) {
+        *out = gEvents[gEventHead];
+    }
+
+    gEventHead = (gEventHead + 1) % 16;
+    gEventCount--;
+
+    return true;
+}
