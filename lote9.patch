+bool DuelFieldMode::synchronizeSpellTrapFromEngine() {
+    const DuelState* state =
+        DuelEngine_GetState();
+
+    if (state == nullptr) {
+        return false;
+    }
+
+    bool ok = true;
+
+    for (int slot = 0; slot < DUEL_SPELL_TRAP_SIZE; slot++) {
+        ok = syncSpellTrapZone(
+            field_.findZone(
+                FieldSide::Player,
+                FieldZoneType::SpellTrap,
+                static_cast<std::uint8_t>(slot)
+            ),
+            state->player.spellTrap[slot]
+        ) && ok;
+
+        ok = syncSpellTrapZone(
+            field_.findZone(
+                FieldSide::Opponent,
+                FieldZoneType::SpellTrap,
+                static_cast<std::uint8_t>(slot)
+            ),
+            state->opponent.spellTrap[slot]
+        ) && ok;
+    }
+
+    return ok;
+}
