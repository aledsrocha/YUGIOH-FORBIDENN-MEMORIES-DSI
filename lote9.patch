+/* Espelha uma carta da fileira de magia/armadilha do motor numa zona visual. */
+bool syncSpellTrapZone(
+    FieldZone* zone,
+    const DuelSetCard& engineCard
+) {
+    if (
+        zone == nullptr ||
+        zone->type() != FieldZoneType::SpellTrap
+    ) {
+        return false;
+    }
+
+    if (engineCard.cardId == 0) {
+        if (zone->isOccupied()) {
+            zone->clear();
+        }
+
+        return true;
+    }
+
+    const std::uint16_t visualCardIndex =
+        static_cast<std::uint16_t>(
+            engineCard.cardId - 1
+        );
+
+    if (
+        zone->isOccupied() &&
+        zone->cardIndex() != visualCardIndex
+    ) {
+        zone->clear();
+    }
+
+    if (zone->isEmpty()) {
+        return zone->placeCard(
+            visualCardIndex,
+            engineCard.faceUp,
+            MonsterPosition::Attack
+        );
+    }
+
+    zone->setFaceUp(engineCard.faceUp);
+
+    return true;
+}
