+bool DuelFieldMode::presentNextEvent() {
+    DuelEvent event;
+
+    if (!DuelEngine_PopEvent(&event)) {
+        return false;
+    }
+
+    const char* message = "";
+
+    switch (event.type) {
+        case DUEL_EVENT_ATTACK_TRAP:
+            message = "ATTACKER DESTROYED";
+            break;
+        case DUEL_EVENT_FAKE_TRAP:
+            message = "NOTHING HAPPENS";
+            break;
+        case DUEL_EVENT_GOBLIN_FAN:
+            message = "DAMAGE REFLECTED";
+            break;
+        case DUEL_EVENT_BAD_REACTION:
+            message = "HEAL TURNED TO DAMAGE";
+            break;
+        case DUEL_EVENT_REVERSE_TRAP:
+            message = "POWER-UP REVERSED";
+            break;
+        default:
+            break;
+    }
+
+    /* verde: a armadilha e do jogador; vermelho: a CPU armou contra ele */
+    synchronizeMonsterFieldsFromEngine();
+
+    return showMessage(
+        event.trapCardId,
+        message,
+        !event.trapOwnerIsOpponent
+    );
+}
