+/* ---------- fila de eventos (armadilhas disparadas) ---------- */
+static DuelEvent gEvents[16];
+static int gEventHead = 0;
+static int gEventCount = 0;
+
+static void ClearEvents() {
+    gEventHead = 0;
+    gEventCount = 0;
+}
+
+static void PushEvent(int type, int trapCardId, bool opponentOwns, int amount, int victimCardId) {
+    if (gEventCount >= 16) {
+        return;
+    }
+
+    DuelEvent& e = gEvents[(gEventHead + gEventCount) % 16];
+
+    e.type = type;
+    e.trapCardId = trapCardId;
+    e.trapOwnerIsOpponent = opponentOwns;
+    e.amount = amount;
+    e.victimCardId = victimCardId;
+    gEventCount++;
+}
+
+/* Limiares de ATK das armadilhas 681-686 (gDuel_abTrapAttackThresholds * 100) */
+static const int kAttackTrapThreshold[6] = {500, 1000, 1500, 2000, 3000, 25500};
+
+/* Consome a primeira armadilha baixada `trapId` do dono. true se havia. */
+static bool ConsumeSetTrap(DuelPlayerState* owner, int trapId, int type, int amount, int victimCardId) {
+    for (int i = 0; i < DUEL_SPELL_TRAP_SIZE; i++) {
+        if (owner->spellTrap[i].cardId == trapId) {
+            owner->spellTrap[i].cardId = 0;
+            owner->spellTrap[i].faceUp = false;
+            PushEvent(type, trapId, owner == &duel.opponent, amount, victimCardId);
+            return true;
+        }
+    }
+
+    return false;
+}
+
+/*
+    Duel_SelectAttackTrap: as armadilhas baixadas do defensor disparam quando o ATK do
+    atacante (com equips e terreno, sem estrela) e <= limiar. Vale a de menor id. Sem
+    nenhuma elegivel, a Fake Trap (se houver) dispara e a batalha segue. true = atacante eliminado.
+*/
+static bool ResolveAttackTrap(
+    DuelPlayerState* attackerOwner,
+    DuelPlayerState* defenderOwner,
+    int attackerIndex,
+    int attackerPower
+) {
+    int chosen = -1;
+    int chosenId = 0;
+    int fake = -1;
+
+    for (int i = 0; i < DUEL_SPELL_TRAP_SIZE; i++) {
+        const int id = defenderOwner->spellTrap[i].cardId;
+
+        if (id == DUEL_FAKE_TRAP_CARD_ID && fake < 0) {
+            fake = i;
+        }
+
+        const int index = id - DUEL_FIRST_ATTACK_TRAP_CARD_ID;
+
+        if (index < 0 || index >= 6) {
+            continue;
+        }
+
+        if (attackerPower <= kAttackTrapThreshold[index] && (chosen < 0 || id < chosenId)) {
+            chosen = i;
+            chosenId = id;
+        }
+    }
+
+    DuelFieldCard* attacker = &attackerOwner->field[attackerIndex];
+
+    if (chosen >= 0) {
+        const int victim = attacker->cardId;
+
+        defenderOwner->spellTrap[chosen].cardId = 0;
+        defenderOwner->spellTrap[chosen].faceUp = false;
+        PushEvent(DUEL_EVENT_ATTACK_TRAP, chosenId, defenderOwner == &duel.opponent, attackerPower, victim);
+        ClearFieldCard(attacker);
+
+        return true;
+    }
+
+    if (fake >= 0) {
+        defenderOwner->spellTrap[fake].cardId = 0;
+        defenderOwner->spellTrap[fake].faceUp = false;
+        PushEvent(DUEL_EVENT_FAKE_TRAP, DUEL_FAKE_TRAP_CARD_ID, defenderOwner == &duel.opponent, 0, attacker->cardId);
+    }
+
+    return false;
+}
