+bool DuelEngine_GuardianStarBeats(int star, int otherStar) {
+    if (star < 1 || star > 10 || otherStar < 1 || otherStar > 10) {
+        return false;
+    }
+
+    /* grupo 1: Marte..Netuno (1..6) | grupo 2: Mercurio..Venus (7..10) */
+    bool firstGroup = star <= 6;
+
+    if (firstGroup != (otherStar <= 6)) {
+        return false;
+    }
+
+    int next;
+
+    if (firstGroup) {
+        next = (star == 6) ? 1 : star + 1;
+    } else {
+        next = (star == 10) ? 7 : star + 1;
+    }
+
+    return otherStar == next;
+}
+
+bool DuelEngine_SetGuardianStar(int fieldIndex, int choice) {
+    if (
+        duel.finished ||
+        fieldIndex < 0 ||
+        fieldIndex >= DUEL_FIELD_SIZE
+    ) {
+        return false;
+    }
+
+    DuelFieldCard* fieldCard = &duel.player.field[fieldIndex];
+
+    if (fieldCard->cardId == 0) {
+        return false;
+    }
+
+    fieldCard->guardianStar =
+        PickGuardianStar(GameData_GetCardById(fieldCard->cardId), choice);
+
+    return true;
+}
