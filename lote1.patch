+    Estrela escolhida ao invocar: choice 0 = primeira, 1 = segunda
+    (se a carta nao tiver segunda estrela, usa a primeira).
+*/
+static uint8_t PickGuardianStar(const CardData* card, int choice) {
+    if (!card) return 0;
+
+    if (choice == 1 && card->guardian2 != 0) {
+        return card->guardian2;
+    }
+
+    return card->guardian1;
+}
