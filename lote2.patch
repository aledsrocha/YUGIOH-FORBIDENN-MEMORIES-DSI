+bool DuelEngine_StartWithPlayerDeck(
+    const uint16_t* playerCardIds,
+    int cardCount,
+    const DuelistData* opponentDuelist
+) {
+    if (
+        playerCardIds == nullptr ||
+        opponentDuelist == nullptr ||
+        cardCount != DUEL_DECK_SIZE
+    ) {
+        return false;
+    }
+
+    for (int i = 0; i < cardCount; i++) {
+        if (GameData_GetCardById(playerCardIds[i]) == nullptr) {
+            return false;
+        }
+    }
+
+    memset(&duel, 0, sizeof(DuelState));
+
+    ClearPlayerState(&duel.player);
+    ClearPlayerState(&duel.opponent);
+
+    for (int i = 0; i < cardCount; i++) {
+        duel.player.deck.cards[i] = playerCardIds[i];
+    }
+
+    duel.player.deck.count = cardCount;
+    duel.player.deck.drawIndex = 0;
+
+    if (!BuildDeck(&duel.opponent.deck, opponentDuelist)) {
+        return false;
+    }
+
+    ShuffleDeck(&duel.player.deck);
+    ShuffleDeck(&duel.opponent.deck);
+
+    if (!FillHand(&duel.player) || !FillHand(&duel.opponent)) {
+        return false;
+    }
+
+    duel.turn = DUEL_TURN_PLAYER;
+    duel.finishReason = DUEL_FINISH_NONE;
+    duel.turnNumber = 1;
+    duel.finished = false;
+    duel.playerWon = false;
+
+    return true;
+}
+
+void DuelEngine_SeedRandom(uint32_t seed) {
+    srand(seed);
+}
+
+int DuelEngine_FindPlayerHandSlotByOrder(int order) {
+    if (order < 0) {
+        return -1;
+    }
+
+    int seen = 0;
+
+    for (int slot = 0; slot < DUEL_HAND_SIZE; slot++) {
+        if (duel.player.hand.cards[slot] != 0) {
+            if (seen == order) {
+                return slot;
+            }
+
+            seen++;
+        }
+    }
+
+    return -1;
+}
