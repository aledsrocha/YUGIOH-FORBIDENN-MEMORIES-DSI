+bool DuelFieldMode::synchronizeHandFromEngine() {
+    const DuelState* state =
+        DuelEngine_GetState();
+
+    if (state == nullptr) {
+        return false;
+    }
+
+    playerHand_.clear();
+
+    for (
+        int slot = 0;
+        slot < DUEL_HAND_SIZE;
+        slot++
+    ) {
+        const std::uint16_t engineCardId =
+            state->player.hand.cards[slot];
+
+        if (engineCardId == 0) {
+            continue;
+        }
+
+        if (!playerHand_.addCard(
+            static_cast<std::uint16_t>(
+                engineCardId - 1
+            )
+        )) {
+            return false;
+        }
+    }
+
+    normalizeHandSelection();
+
+    return true;
+}
