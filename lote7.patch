+void DuelOverlay_DrawSpellBanner(int cardId, const DuelSpellOutcome& outcome) {
+    static const char* const terrains[] = {
+        "", "FOREST", "WASTELAND", "MOUNTAIN", "SOGEN", "UMI", "YAMI"
+    };
+
+    const CardData* card = GameData_GetCardById(cardId);
+
+    if (card == nullptr) {
+        return;
+    }
+
+    char message[40];
+
+    switch (outcome.effectGroup) {
+        case DUEL_EFFECT_GROUP_TERRAIN:
+            std::snprintf(
+                message, sizeof(message), "FIELD: %s",
+                outcome.amount >= 1 && outcome.amount <= DUEL_TERRAIN_COUNT
+                    ? terrains[outcome.amount] : ""
+            );
+            break;
+        case DUEL_EFFECT_GROUP_LIFE_POINT_RECOVERY:
+            std::snprintf(message, sizeof(message), "YOU RECOVER %d LP", outcome.amount);
+            break;
+        case DUEL_EFFECT_GROUP_DIRECT_DAMAGE:
+            std::snprintf(message, sizeof(message), "CPU LOSES %d LP", outcome.amount);
+            break;
+        case DUEL_EFFECT_GROUP_BOARD_DESTRUCTION:
+        case DUEL_EFFECT_GROUP_RAIGEKI:
+        case DUEL_EFFECT_GROUP_MONSTER_REMOVAL:
+            if (outcome.destroyed > 0) {
+                std::snprintf(message, sizeof(message), "%d DESTROYED", outcome.destroyed);
+            } else {
+                std::snprintf(message, sizeof(message), "NOTHING DESTROYED");
+            }
+            break;
+        case DUEL_EFFECT_GROUP_STOP_DEFENSE:
+            if (outcome.affected > 0) {
+                std::snprintf(message, sizeof(message), "%d TO ATTACK", outcome.affected);
+            } else {
+                std::snprintf(message, sizeof(message), "NO TARGETS");
+            }
+            break;
+        case DUEL_EFFECT_GROUP_DARK_PIERCING_LIGHT:
+            if (outcome.affected > 0) {
+                std::snprintf(message, sizeof(message), "%d REVEALED", outcome.affected);
+            } else {
+                std::snprintf(message, sizeof(message), "NOTHING HIDDEN");
+            }
+            break;
+        case DUEL_EFFECT_GROUP_STAT_PENALTY:
+            std::snprintf(message, sizeof(message), "ENEMIES -%d ATK DEF", outcome.amount);
+            break;
+        case DUEL_EFFECT_GROUP_SWORDS:
+            std::snprintf(message, sizeof(message), "NO ATTACK FOR %d TURNS", outcome.amount);
+            break;
+        case DUEL_EFFECT_GROUP_CURSEBREAKER:
+            if (outcome.affected > 0) {
+                std::snprintf(message, sizeof(message), "%d CURED", outcome.affected);
+            } else {
+                std::snprintf(message, sizeof(message), "NOTHING TO CURE");
+            }
+            break;
+        case DUEL_EFFECT_GROUP_HARPIES_FEATHER_DUSTER:
+            std::snprintf(message, sizeof(message), "NO MAGIC IN PLAY");
+            break;
+        default:
+            message[0] = '\0';
+            break;
+    }
+
+    constexpr int x = 40;
+    constexpr int y = 80;
+    constexpr int width = 176;
+    constexpr int height = 32;
+
+    PixelText_Fill(x, y, width, height, PixelText_Color(2, 3, 8));
+    PixelText_Frame(x, y, width, height, PixelText_Color(28, 22, 6));
+
+    char name[24];
+
+    copyName(name, sizeof(name), card->name, 21);
+    PixelText_Draw(x + 4, y + 4, name, PixelText_Color(18, 31, 20));
+    PixelText_Draw(x + 4, y + 17, message, PixelText_Color(31, 31, 31));
+}
+
+void DuelOverlay_DrawSwordsBadges() {
+    char text[16];
+
+    /* adversario sob Swords: mostra quantos turnos dele ainda ficam sem ataque */
+    const int cpu = DuelEngine_GetSwordsTurns(true);
+
+    if (cpu > 1) {
+        std::snprintf(text, sizeof(text), "SWORDS %d", cpu - 1);
+        PixelText_Fill(kBadgeX, kBadgeY + kBadgeHeight + 2, kBadgeWidth, kBadgeHeight, PixelText_Color(2, 3, 8));
+        PixelText_Frame(kBadgeX, kBadgeY + kBadgeHeight + 2, kBadgeWidth, kBadgeHeight, PixelText_Color(28, 22, 6));
+        PixelText_Draw(
+            kBadgeX + (kBadgeWidth - PixelText_Width(text, 1)) / 2,
+            kBadgeY + kBadgeHeight + 6, text, PixelText_Color(31, 31, 31), 1
+        );
+    }
+
+    /* jogador sob Swords: nao pode atacar neste turno */
+    const int you = DuelEngine_GetSwordsTurns(false);
+
+    if (you > 0) {
+        std::snprintf(text, sizeof(text), "NO ATK %d", you);
+        PixelText_Fill(96, 172, 56, kBadgeHeight, PixelText_Color(8, 2, 2));
+        PixelText_Frame(96, 172, 56, kBadgeHeight, PixelText_Color(31, 10, 8));
+        PixelText_Draw(
+            96 + (56 - PixelText_Width(text, 1)) / 2, 176, text, PixelText_Color(31, 31, 31), 1
+        );
+    }
+}
+
 void DuelOverlay_DrawTerrainBadge(int terrain) {
     static const char* const names[] = {
         "", "FOREST", "WASTELAND", "MOUNTAIN", "SOGEN", "UMI", "YAMI"
