+namespace {
+
+/* Cura e dano direto do jogo original, por carta (338-342 e 343-347) */
+const int kLifeRecovery[5] = {200, 500, 1000, 2000, 5000};
+const int kDirectDamage[5] = {50, 100, 200, 500, 1000};
+
+/* Tipo de monstro destruido por cada magia de remocao (Crush Card usa ATK) */
+int RemovalType(int cardId) {
+    switch (cardId) {
+        case 653: return 3;   /* Warrior Elimination: Warrior */
+        case 656: return 2;   /* Eternal Rest: Zombie */
+        case 660: return 14;  /* Stain Storm: Machine */
+        case 662: return 9;   /* Eradicating Aerosol: Insect */
+        case 663: return 18;  /* Breath of Light: Rock */
+        case 664: return 12;  /* Eternal Draught: Fish */
+        default: return -1;
+    }
+}
+
+constexpr int kCrushCardCardId = 661;
+constexpr int kCrushCardAttack = 1500;
+constexpr int kDragonCaptureJarCardId = 329;
+constexpr int kSpellbindingCircleCardId = 349;
+constexpr int kDragonType = 0;
+
+int Destroy(DuelPlayerState* side, bool (*match)(const DuelPlayerState*, int, int), int arg) {
+    int destroyed = 0;
+
+    for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+        if (side->field[i].cardId == 0) {
+            continue;
+        }
+
+        if (match(side, i, arg)) {
+            ClearFieldCard(&side->field[i]);
+            destroyed++;
+        }
+    }
+
+    return destroyed;
+}
+
+bool MatchAny(const DuelPlayerState*, int, int) {
+    return true;
+}
+
+bool MatchType(const DuelPlayerState* side, int i, int type) {
+    const CardData* card = GameData_GetCardById(side->field[i].cardId);
+    return card != nullptr && card->type == type;
+}
+
+bool MatchAttackAtLeast(const DuelPlayerState* side, int i, int threshold) {
+    return GetFieldPower(side, i, true) >= threshold;
+}
+
+}
+
+bool DuelEngine_PlaySpellFromHand(int handIndex, DuelSpellOutcome* outcome) {
+    DuelSpellOutcome result = {0, 0, 0, 0};
+
+    if (
+        duel.finished ||
+        duel.turn != DUEL_TURN_PLAYER ||
+        handIndex < 0 ||
+        handIndex >= DUEL_HAND_SIZE
+    ) {
+        return false;
+    }
+
+    const int cardId = duel.player.hand.cards[handIndex];
+    const CardData* card = GameData_GetCardById(cardId);
+
+    /* so cartas Magic (type 20); equips, armadilhas e rituais tem fluxo proprio */
+    if (card == nullptr || card->type != 20) {
+        return false;
+    }
+
+    DuelPlayerState* me = &duel.player;
+    DuelPlayerState* foe = &duel.opponent;
+    const int group = DuelEngine_GetCardEffectGroup(cardId);
+
+    result.effectGroup = group;
+
+    switch (group) {
+        case DUEL_EFFECT_GROUP_TERRAIN: {
+            const int terrain = cardId - DUEL_FIRST_TERRAIN_CARD_ID + 1;
+
+            if (terrain < 1 || terrain > DUEL_TERRAIN_COUNT) {
+                return false;
+            }
+
+            DuelEngine_SetTerrain(terrain);
+            result.amount = terrain;
+            break;
+        }
+
+        case DUEL_EFFECT_GROUP_LIFE_POINT_RECOVERY: {
+            const int index = cardId - 338;
+
+            if (index < 0 || index > 4) {
+                return false;
+            }
+
+            /* sobe ate o maximo (8000), sem reduzir quem ja esta acima */
+            const int ceiling =
+                me->lifePoints > DUEL_START_LP ? me->lifePoints : DUEL_START_LP;
+            int healed = me->lifePoints + kLifeRecovery[index];
+
+            me->lifePoints = healed > ceiling ? ceiling : healed;
+            result.amount = kLifeRecovery[index];
+            break;
+        }
+
+        case DUEL_EFFECT_GROUP_DIRECT_DAMAGE: {
+            const int index = cardId - 343;
+
+            if (index < 0 || index > 4) {
+                return false;
+            }
+
+            foe->lifePoints -= kDirectDamage[index];
+
+            if (foe->lifePoints < 0) {
+                foe->lifePoints = 0;
+            }
+
+            result.amount = kDirectDamage[index];
+            break;
+        }
+
+        case DUEL_EFFECT_GROUP_BOARD_DESTRUCTION:
+            if (cardId == kDragonCaptureJarCardId) {
+                result.destroyed = Destroy(foe, MatchType, kDragonType);
+            } else {
+                result.destroyed =
+                    Destroy(me, MatchAny, 0) +
+                    Destroy(foe, MatchAny, 0);
+            }
+            break;
+
+        case DUEL_EFFECT_GROUP_RAIGEKI:
+            result.destroyed = Destroy(foe, MatchAny, 0);
+            break;
+
+        case DUEL_EFFECT_GROUP_MONSTER_REMOVAL:
+            if (cardId == kCrushCardCardId) {
+                result.destroyed =
+                    Destroy(foe, MatchAttackAtLeast, kCrushCardAttack);
+            } else {
+                const int type = RemovalType(cardId);
+
+                if (type < 0) {
+                    return false;
+                }
+
+                result.destroyed = Destroy(foe, MatchType, type);
+            }
+            break;
+
+        case DUEL_EFFECT_GROUP_STOP_DEFENSE:
+            for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+                DuelFieldCard& monster = foe->field[i];
+
+                if (monster.cardId != 0 && monster.position == DUEL_POSITION_DEFENSE) {
+                    monster.position = DUEL_POSITION_ATTACK;
+                    result.affected++;
+                }
+            }
+            break;
+
+        case DUEL_EFFECT_GROUP_DARK_PIERCING_LIGHT:
+            for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+                if (me->field[i].cardId != 0 && !me->field[i].faceUp) {
+                    me->field[i].faceUp = true;
+                    result.affected++;
+                }
+
+                if (foe->field[i].cardId != 0 && !foe->field[i].faceUp) {
+                    foe->field[i].faceUp = true;
+                    result.affected++;
+                }
+            }
+            break;
+
+        case DUEL_EFFECT_GROUP_STAT_PENALTY: {
+            const int penalty =
+                cardId == kSpellbindingCircleCardId
+                    ? DUEL_EQUIP_BONUS
+                    : 2 * DUEL_EQUIP_BONUS;
+
+            for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+                if (foe->field[i].cardId != 0) {
+                    foe->field[i].attackBonus -= penalty;
+                    foe->field[i].defenseBonus -= penalty;
+                    result.affected++;
+                }
+            }
+
+            result.amount = penalty;
+            break;
+        }
+
+        case DUEL_EFFECT_GROUP_SWORDS:
+            for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+                if (foe->field[i].cardId != 0 && !foe->field[i].faceUp) {
+                    foe->field[i].faceUp = true;
+                    result.affected++;
+                }
+            }
+
+            foe->swordsTurnsRemaining = DUEL_SWORDS_INITIAL_COUNTER;
+            result.amount = DUEL_SWORDS_INITIAL_COUNTER - 1;
+            break;
+
+        case DUEL_EFFECT_GROUP_CURSEBREAKER:
+            /* so remove penalidades (modificadores negativos); equips continuam */
+            for (int i = 0; i < DUEL_FIELD_SIZE; i++) {
+                DuelFieldCard& monster = me->field[i];
+                bool cured = false;
+
+                if (monster.cardId == 0) {
+                    continue;
+                }
+
+                if (monster.attackBonus < 0) {
+                    monster.attackBonus = 0;
+                    cured = true;
+                }
+
+                if (monster.defenseBonus < 0) {
+                    monster.defenseBonus = 0;
+                    cured = true;
+                }
+
+                result.affected += cured ? 1 : 0;
+            }
+            break;
+
+        case DUEL_EFFECT_GROUP_HARPIES_FEATHER_DUSTER:
+            /* destroi as magias e armadilhas do adversario em campo: ainda nao ha nenhuma */
+            break;
+
+        default:
+            return false;
+    }
+
+    duel.player.hand.cards[handIndex] = 0;
+
+    if (outcome != nullptr) {
+        *outcome = result;
+    }
+
+    CheckLifePoints();
+
+    return true;
+}
